<Window x:Class="RAMPilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RAMPilot — Smart PC Optimizer" Width="1100" Height="720" MinWidth="900" MinHeight="600" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0D1528"><StackPanel Margin="20,28,20,20"><TextBlock Text="⚡" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="RAMPilot" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="SMART PC OPTIMIZER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,35"/><Button Content="⌂   Overview" Tag="overview" Click="Nav_Click" Style="{StaticResource NavButton}"/><Button Content="◉   Memory" Tag="memory" Click="Nav_Click" Style="{StaticResource NavButton}"/><Button Content="▦   Processes" Tag="processes" Click="Nav_Click" Style="{StaticResource NavButton}"/><Button Content="⚙   Settings" Tag="settings" Click="Nav_Click" Style="{StaticResource NavButton}"/><StackPanel VerticalAlignment="Bottom" Margin="0,260,0,0"><TextBlock Text="STEP 5" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="Native Windows Engine" FontSize="8" Foreground="#52627F" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,20"><DockPanel><TextBlock Text="PC Overview" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="Health" Text="● HEALTHY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
<Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Margin="0,20,0,14" Padding="25"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Memory health" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="Hero" Text="--" FontSize="38" FontWeight="Bold" Margin="0,2,0,0"/><TextBlock x:Name="Detail" Text="Checking memory…" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1"><Button x:Name="BoostButton" Content="⚡  BOOST" Click="Boost_Click" Height="52" FontSize="15" FontWeight="Bold" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/><Button x:Name="AutoButton" Content="🤖  AUTO BOOST: OFF" Click="Auto_Click" Height="38" Margin="0,10,0,0" Background="{StaticResource Panel2}" Foreground="{StaticResource Text}" BorderThickness="0"/></StackPanel></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource Caption}"/><TextBlock x:Name="Available" Style="{StaticResource Metric}"/><TextBlock Text="Available RAM" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource Caption}"/><TextBlock x:Name="Cpu" Style="{StaticResource Metric}"/><TextBlock Text="Current load" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL RAM" Style="{StaticResource Caption}"/><TextBlock x:Name="Total" Style="{StaticResource Metric}"/><TextBlock Text="Installed memory" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTO" Style="{StaticResource Caption}"/><TextBlock x:Name="AutoState" Text="OFF" Style="{StaticResource Metric}"/><TextBlock Text="Optimizer state" Style="{StaticResource Caption}"/></StackPanel></Border></Grid>
<Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Margin="0,14,0,0" Padding="18"><StackPanel><DockPanel><TextBlock Text="Active applications" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="Count" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><DataGrid x:Name="Apps" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" RowBackground="{StaticResource Panel}" AlternatingRowBackground="{StaticResource Panel2}" Height="280" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="MEMORY" Binding="{Binding Memory}" Width="120"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel></Border><TextBlock x:Name="Footer" Text="RAMPilot • Native Windows monitor" Foreground="{StaticResource Muted}" FontSize="9" Margin="2,9,0,0"/></StackPanel></ScrollViewer></Grid></Window>